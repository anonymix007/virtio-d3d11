    src/dxgi/dxgi_options.cpp

DXVK_SHADERS := \
    src/dxvk/shaders/dxvk_cursor_vert.vert \
    src/dxvk/shaders/dxvk_cursor_frag.frag \
    src/dxvk/shaders/dxvk_dummy_frag.frag \
    src/dxvk/shaders/dxvk_mipgen.comp \
    src/dxvk/shaders/dxvk_present_frag.frag \
    src/dxvk/shaders/dxvk_present_frag_blit.frag \
    src/dxvk/shaders/dxvk_present_frag_ms.frag \
    src/dxvk/shaders/dxvk_present_frag_ms_blit.frag \
    src/dxvk/shaders/dxvk_present_vert.vert \
    src/dxvk/hud/shaders/hud_chunk_frag_background.frag \
    src/dxvk/hud/shaders/hud_chunk_frag_visualize.frag \
    src/dxvk/hud/shaders/hud_chunk_vert_background.vert \
    src/dxvk/hud/shaders/hud_chunk_vert_visualize.vert \
    src/dxvk/hud/shaders/hud_frame_time_eval.comp \
    src/dxvk/hud/shaders/hud_graph_frag.frag \
    src/dxvk/hud/shaders/hud_graph_vert.vert \
    src/dxvk/hud/shaders/hud_text_frag.frag \
    src/dxvk/hud/shaders/hud_text_vert.vert

D3D11_SHADERS = \
    src/d3d11/shaders/d3d11_video_blit_frag.frag \
    src/d3d11/shaders/d3d11_video_blit_vert.vert \
    src/d3d11/shaders/d3d11_composition_frag.frag \
    src/d3d11/shaders/d3d11_composition_vert.vert

DXVK_SHADER_HEADERS := $(addprefix build/,$(addsuffix .h,$(basename $(DXVK_SHADERS) $(D3D11_SHADERS))))

DXGI_OBJS := $(addprefix build/,$(addsuffix .o,$(basename $(DXGI_SRC))))
DXVK_OBJS := $(addprefix build/,$(addsuffix .o,$(basename $(UTIL_SRC) $(DXBC_SRC) $(DXVK_SRC) $(VK_COMMON_SRC) $(SPIRV_SRC))))
D3D11_OBJS := $(addprefix build/,$(addsuffix .o,$(basename $(D3D11_SRC) $(D3D10_SRC))))

build/dxvk.a: $(DXVK_OBJS)
	$(AR) rcs $@ $^

build/dxvk-d3d11.a: $(D3D11_OBJS)
	$(AR) rcs $@ $^

build/dxvk-dxgi.a: $(DXGI_OBJS)
	$(AR) rcs $@ $^

build/%.o: $(DXVK_PATH)/%.cpp $(DXVK_SHADER_HEADERS) build/version.h build/buildenv.h | build
	@mkdir -p $(dir $@)
	$(CXX) $(COMMON_FLAGS) $(CXXFLAGS) -c -o $@ $<

build/%.o: $(DXVK_PATH)/%.c $(DXVK_SHADER_HEADERS) build/version.h build/buildenv.h | build
	@mkdir -p $(dir $@)
	$(CC) $(COMMON_FLAGS) $(CFLAGS) -c -o $@ $<

build/%.h: $(DXVK_PATH)/%.comp | build
	@mkdir -p $(dir $@)
	$(GLSLANG) $(GLSL_ARGS) -V --vn "$(basename $(notdir $<))" --depfile "build/$(basename $(notdir $<)).d" $< -o $@

build/%.h: $(DXVK_PATH)/%.vert | build
	@mkdir -p $(dir $@)
	$(GLSLANG) $(GLSL_ARGS) -V --vn "$(basename $(notdir $<))" --depfile "build/$(basename $(notdir $<)).d" $< -o $@

build/%.h: $(DXVK_PATH)/%.frag | build
	@mkdir -p $(dir $@)
	$(GLSLANG) $(GLSL_ARGS) -V --vn "$(basename $(notdir $<))" --depfile "build/$(basename $(notdir $<)).d" $< -o $@

build/%.h: $(DXVK_PATH)/%.geom | build
	@mkdir -p $(dir $@)
	$(GLSLANG) $(GLSL_ARGS) -V --vn "$(basename $(notdir $<))" --depfile "build/$(basename $(notdir $<)).d" $< -o $@

build/version.h: $(DXVK_PATH)/version.h.in | build
	sed "s#@VCS_TAG@#$(DXVK_GIT_VERSION)#" $< > $@

build/buildenv.h: $(DXVK_PATH)/buildenv.h.in | build
	sed "s#@BUILD_TARGET@#$(DXVK_TARGET)#; s#@BUILD_COMPILER@#$(DXVK_COMPILER)#; s#@BUILD_COMPILER_VERSION@#$(DXVK_COMPILER_VERSION)#;" $< > $@
