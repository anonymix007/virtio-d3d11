GLSLANG ?= glslangValidator

GLSL_ARGS = --quiet --target-env vulkan1.3

DXVK_PATH := thirdparty/dxvk
DXVK_DEFINES := \
    DXBC_SPV_ENABLE_SM3 \
    DXBC_SPV_ENABLE_SM5 \
    DXBC_SPV_ENABLE_SPIRV \
    DXVK_BUILD_UMD

DXVK_INCLUDES := \
    $(DXVK_PATH) \
    $(DXVK_PATH)/include \
    $(DXVK_PATH)/include/vulkan/include \
    $(DXVK_PATH)/include/spirv/include \
    $(DXVK_PATH)/src/d3d11 \
    $(DXVK_PATH)/src/dxgi \
    $(DXVK_PATH)/src/dxvk \
    $(DXVK_PATH)/src/vulkan \
    $(DXVK_PATH)/src/util \
    build/src/dxvk/shaders \
    build/src/dxvk/hud/shaders \
    build/src/d3d11/shaders \
    $(DXVK_PATH)/subprojects/dxbc-spirv

COMMON_FLAGS+=$(addprefix -I,$(DXVK_INCLUDES)) $(addprefix -D,$(DXVK_DEFINES))

DXVK_GIT_VERSION=$(shell git -C $(DXVK_PATH) describe --dirty=+)
DXVK_TARGET=$(PREFIX)
DXVK_COMPILER=$(CC)
DXVK_COMPILER_VERSION=$(shell $(CC) --version | head -1)

UTIL_SRC := \
    src/util/util_env.cpp \
    src/util/util_string.cpp \
    src/util/util_fps_limiter.cpp \
    src/util/util_file.cpp \
    src/util/util_flush.cpp \
    src/util/util_gdi.cpp \
    src/util/util_luid.cpp \
    src/util/util_matrix.cpp \
    src/util/util_shared_res.cpp \
    src/util/util_sleep.cpp \
    src/util/util_unmap.cpp \
    src/util/thread.cpp \
    src/util/com/com_destruction_notifier.cpp \
    src/util/com/com_guid.cpp \
    src/util/com/com_private_data.cpp \
    src/util/config/config.cpp \
    src/util/log/log.cpp \
    src/util/log/log_debug.cpp \
    src/util/sha1/sha1.c \
    src/util/sha1/sha1_util.cpp \
    src/util/sync/sync_recursive.cpp \

SPIRV_SRC := \
    src/spirv/spirv_code_buffer.cpp

VK_COMMON_SRC := \
	src/vulkan/vulkan_loader.cpp \
	src/vulkan/vulkan_names.cpp

