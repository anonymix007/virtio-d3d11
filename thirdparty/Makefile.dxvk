    subprojects/dxbc-spirv/sm3/sm3_resources.cpp \
    subprojects/dxbc-spirv/dxbc/dxbc_api.cpp \
    subprojects/dxbc-spirv/dxbc/dxbc_container.cpp \
    subprojects/dxbc-spirv/dxbc/dxbc_converter.cpp \
    subprojects/dxbc-spirv/dxbc/dxbc_disasm.cpp \
    subprojects/dxbc-spirv/dxbc/dxbc_interface.cpp \
    subprojects/dxbc-spirv/dxbc/dxbc_io_map.cpp \
    subprojects/dxbc-spirv/dxbc/dxbc_parser.cpp \
